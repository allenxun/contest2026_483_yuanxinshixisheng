# InsightFace-for-openvela -- PUBLIC EXAMPLE ONLY.
#
# This file contains NO secrets. Copy it to a deployment-local env file kept at
# mode 0600 OUTSIDE the repository and fill in real values there. Never commit a
# real token. Generate one at deploy time with:
#   openssl rand -hex 32 > ~/.config/face-service-openvela.token
#   chmod 600 ~/.config/face-service-openvela.token
#
# All keys are prefixed FACE_SVC_.

# --- binding -------------------------------------------------------------
FACE_SVC_HOST=10.3.6.163
FACE_SVC_PORT=8010

# --- data (isolated SQLite) ----------------------------------------------
# FACE_SVC_DATA_DIR=/home/bool/deployment/InsightFace-for-openvela/data
# FACE_SVC_DB_PATH=/home/bool/deployment/InsightFace-for-openvela/data/openvela_faces.sqlite3

# --- model ---------------------------------------------------------------
# Read-only reuse of the existing insightface models directory.
FACE_SVC_MODEL_ROOT=/home/bool/.insightface/models
FACE_SVC_MODEL_NAME=buffalo_l
FACE_SVC_MODEL_VERSION=buffalo_l@insightface-0.7.3

# --- matching / limits ---------------------------------------------------
# 1:1 threshold. Used by POST /v1/verify (probe vs a REGISTERED subject) and as
# the default for POST /v1/compare (probe vs probe). /v1/compare may override it
# per request because it reads no namespace; search never accepts a threshold.
FACE_SVC_VERIFY_THRESHOLD=0.40

# 1:N search policy (server-fixed; clients cannot override per request).
# 0.60 is deliberately stricter than the 1:1 0.40 because false accepts grow
# with library size.  These are CONSERVATIVE PLACEHOLDERS, NOT calibrated
# results; re-calibrate on authorised samples before enabling auto-enrolment.
FACE_SVC_SEARCH_MATCH_THRESHOLD=0.60
FACE_SVC_SEARCH_UNCERTAIN_BAND=0.10
FACE_SVC_SEARCH_MARGIN=0.05
# Range 2..10 (NOT 1): top_k only bounds the candidate window used by the
# margin rule; top_k=1 leaves no runner-up and would disable ambiguity
# protection. Values outside 2..10 are a startup error.
FACE_SVC_SEARCH_TOP_K=5

FACE_SVC_MAX_BODY_BYTES=10485760
FACE_SVC_INFERENCE_TIMEOUT_SECONDS=30
FACE_SVC_MAX_CONCURRENCY=2

# --- internal auth -------------------------------------------------------
# Recommended: point to a 0600 file, do NOT inline the token here.
FACE_SVC_INTERNAL_TOKEN_FILE=/home/bool/.config/face-service-openvela.token
# FACE_SVC_INTERNAL_TOKEN=__SET_AT_DEPLOY_TIME__
#
# Auth is fail-closed by default and MUST stay true while FACE_SVC_HOST is a
# non-loopback address: the service refuses to start if a non-loopback bind has
# auth disabled or has no token configured. Booleans accept only
# 1/true/yes/on or 0/false/no/off (any other value is a startup error).
# Loopback-only local development may set FACE_SVC_HOST=127.0.0.1 and
# FACE_SVC_AUTH_REQUIRED=false -- never do that for a non-loopback bind.
FACE_SVC_AUTH_REQUIRED=true
FACE_SVC_AUTH_HEADER=X-Internal-Token

# --- registration policy / quality gates ---------------------------------
# Default for the optional per-request `on_exists`. Keep `conflict`: the Worker
# relies on 409 SUBJECT_ALREADY_EXISTS to detect a genuinely different enrollment
# attempt. Idempotent retries are keyed by the request's `correlation_id`
# (no config key) and are reconciled through
# GET /v1/namespaces/{ns}/registrations/{correlation_id}.
FACE_SVC_REGISTER_ON_EXISTS=conflict
FACE_SVC_QUALITY_ENFORCE=false
FACE_SVC_QUALITY_MIN_DET_SCORE=0.50
FACE_SVC_QUALITY_MIN_BLUR=30.0
FACE_SVC_QUALITY_MIN_BBOX_RATIO=0.02

# --- misc ----------------------------------------------------------------
FACE_SVC_REQUEST_ID_HEADER=X-Request-Id
FACE_SVC_LOG_LEVEL=INFO
