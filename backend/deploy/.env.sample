# backend/deploy 环境变量样例。复制为 .env 后按环境填写；仓库不保留真实凭据。
# 说明：本地隔离开发容器 mvp-a-pg 的占位口令为 mvp_a_local（仅本机开发，非真实凭据）。
# 变量名以后端代码为准：Java = web-java/application.yml 的 ${...} 占位；
# Python = worker-python/src/mvp_worker/config.py。

# ---- PostgreSQL（compose 内置 pg 服务；生产用外部托管实例时改 host 即可）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mvp_a_dev
# 宿主映射端口：默认 55432（与隔离开发容器一致）。**绝不能绑 5432**——宿主 5432
# 已被共享 pgvector18 占用（COMMON 隔离规则）；compose 内部仍用 pg:5432。
MVP_A_PG_HOST_PORT=55432

# ---- Java Web — 进程/数据源（Spring Boot env 绑定）----
# compose 内已注入 pg 服务地址；本机直跑 jar 时取消注释指向隔离容器：
# SPRING_PROFILES_ACTIVE=dev          # dev(默认，测试替身) / test / prod(=production→fail closed)
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:55432/mvp_a_dev
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=mvp_a_local
SERVER_PORT=8080                      # Java HTTP 监听端口（本机 8080 被占时用 18080）
WEB_PORT=8080                         # compose 宿主映射
DB_POOL_MAX=10                        # HikariCP Web 池上限（联调初值）
DB_POOL_MIN=2                         # HikariCP 最小空闲

# ---- Java Web — 应用配置（app.* 映射，全部可覆盖）----
APP_ENV=dev                           # 对象 key 前缀 environment；prod profile 固定 production
APP_PROVIDERS_MODE=doubles            # doubles=隔离替身(仅 dev/test) / disabled / real(生产)
APP_STORAGE_DEV_DIR=/tmp/mvp-a-storage        # 存储替身根目录（Java 名；与下一行等效互通）
MVP_A_STORAGE_DEV_DIR=/tmp/mvp-a-storage      # 存储替身根目录（Python 名；两侧同值=同目录）
APP_STORAGE_BUCKET=mvp-a-media        # media_objects.bucket 逻辑桶名（真实 OSS 由部署替换）
APP_IMAGE_MAX_BYTES=10485760          # 单图上限 10MiB（DD 12.1 dev 初值）
APP_MEDIA_ACCESS_MODE=deny-all        # 媒体读取：deny-all(生产安全默认)/owner-dev/any-authenticated
APP_IDEMPOTENCY_LEASE_SECONDS=30      # T13 processing 租约（过期 takeover）
JOB_MAX_ATTEMPTS=5                    # enqueue authority for async_jobs.max_attempts
APP_DOUBLE_SMS_CODE=123456            # dev/test 短信验证码替身固定码
APP_DOUBLE_FACE=MATCHED               # dev/test 人脸比对替身结论
# SPRING_MULTIPART_MAX_FILE_SIZE=10MB       # Spring 上传单文件上限
# SPRING_MULTIPART_MAX_REQUEST_SIZE=32MB    # 整请求上限（三图 + metadata）

# ---- Python Worker（T12 运行时；config.py 逐项映射）----
MVP_WORKER_PG_DSN=postgresql://postgres:change-me@pg:5432/mvp_a_dev   # 运行时连接（compose 注入）
MVP_WORKER_POOL_SIZE=5                 # 连接池（max_overflow 固定 0）
MVP_WORKER_CLAIM_BATCH=5               # 每周期领取上限（FOR UPDATE SKIP LOCKED）
MVP_WORKER_LEASE_SECONDS=60            # 领取租约时长
MVP_WORKER_RENEW_INTERVAL_SECONDS=15   # 条件续租间隔
MVP_WORKER_RETRY_MAX_ATTEMPTS=5        # 重试上限（表内 max_attempts 为准，此为默认）
MVP_WORKER_BACKOFF_BASE_SECONDS=5      # 退避基数 min(base*2^(attempt-1), cap)+抖动
MVP_WORKER_BACKOFF_CAP_SECONDS=300     # 退避上限秒
MVP_WORKER_POLL_INTERVAL_SECONDS=2     # 空闲轮询间隔
MVP_WORKER_HEALTH_HOST=127.0.0.1       # compose 内改 0.0.0.0（健康探测仍在容器内 127.0.0.1）
MVP_WORKER_HEALTH_PORT=8081            # /healthz /readyz
MVP_WORKER_ENVIRONMENT=dev             # 媒体 key 前缀 environment
# MVP_CONTRACTS_DIR=../contracts       # 可选：契约目录位置（测试跨语言校验用）

# ---- 测试/迁移工具连接（decisions.md 约定；本机隔离容器默认见 deploy/dev 脚本）----
MVP_A_PG_JDBC=jdbc:postgresql://127.0.0.1:55432/postgres
MVP_A_PG_USER=postgres
MVP_A_PG_PASSWORD=mvp_a_local
MVP_A_PG_DSN=postgresql://postgres:mvp_a_local@127.0.0.1:55432/postgres

# ---- Nginx 入口端口（HTTPS 证书经 volume 挂载，路径见 nginx/nginx.conf.sample 注释）----
NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443
