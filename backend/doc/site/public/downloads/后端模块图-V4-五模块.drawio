          <mxGeometry as="geometry" x="55" y="327" width="355" height="122" />
        </mxCell>
        <mxCell id="chain1" value="M2-A07 查绑定 → 主动 M2-A06；M2-A08 原账号解绑&lt;br&gt;M2-A01/A02 认证心跳；M5-A01 登记目标；通知绑定账号，与成员授权独立。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#f5f7f9;strokeColor=#98a3af;strokeWidth=1.5;spacing=14;align=left;fontSize=17;">
          <mxGeometry as="geometry" x="430" y="327" width="1675" height="122" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;02 测肤、归档与报告&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2ff;strokeColor=#688abb;strokeWidth=1.5;spacing=14;align=left;fontSize=19;">
          <mxGeometry as="geometry" x="55" y="464" width="355" height="122" />
        </mxCell>
        <mxCell id="chain2" value="M3-A01 新测肤受理即替换当前任务；M3-A02 原任务补拍&lt;br&gt;M3-A06 重启恢复当前任务；M3-A03/A05 只取本次结果；云台无历史列表。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#f5f7f9;strokeColor=#98a3af;strokeWidth=1.5;spacing=14;align=left;fontSize=17;">
          <mxGeometry as="geometry" x="430" y="464" width="1675" height="122" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;03 两端报告与方案&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2ff;strokeColor=#688abb;strokeWidth=1.5;spacing=14;align=left;fontSize=19;">
          <mxGeometry as="geometry" x="55" y="601" width="355" height="122" />
        </mxCell>
        <mxCell id="chain3" value="APP M3-A04/A05 查报告；云台 M3-A03/A05 仅取当前任务结果&lt;br&gt;APP M4-A01/A02 查方案；云台 M4-A03 核验领取；结果图片保存 OSS 后受控读取。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#f5f7f9;strokeColor=#98a3af;strokeWidth=1.5;spacing=14;align=left;fontSize=17;">
          <mxGeometry as="geometry" x="430" y="601" width="1675" height="122" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;04 云台核验与追踪&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2ff;strokeColor=#688abb;strokeWidth=1.5;spacing=14;align=left;fontSize=19;">
          <mxGeometry as="geometry" x="55" y="738" width="355" height="122" />
        </mxCell>
        <mxCell id="chain4" value="&lt;b&gt;M4-A03 核验登记 → 端侧检查并运行 → M4-A05 同步&lt;/b&gt;&lt;br&gt;&lt;br&gt;追丢先本地暂停/停止 → 联网后 M4-A04 重验；无网不恢复，已结束执行不重开。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf6ee;strokeColor=#72a17f;strokeWidth=1.5;spacing=14;align=left;fontSize=17;">
          <mxGeometry as="geometry" x="430" y="738" width="1675" height="122" />
        </mxCell>
        <mxCell id="f5" value="&lt;b&gt;05 APP 人脸查看授权&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2ff;strokeColor=#688abb;strokeWidth=1.5;spacing=14;align=left;fontSize=19;">
          <mxGeometry as="geometry" x="55" y="875" width="355" height="122" />
        </mxCell>
        <mxCell id="chain5" value="&lt;b&gt;M1-A01 永久查看授权 → M1-A02 查询关联 → 报告/方案查询&lt;/b&gt;&lt;br&gt;&lt;br&gt;M1-A03 主动撤销后不可查看该成员资料；撤销分支已补入原流程 05 页。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#f5f7f9;strokeColor=#98a3af;strokeWidth=1.5;spacing=14;align=left;fontSize=17;">
          <mxGeometry as="geometry" x="430" y="875" width="1675" height="122" />
        </mxCell>
        <mxCell id="f6" value="&lt;b&gt;06 目标 N 与实际 K&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2ff;strokeColor=#688abb;strokeWidth=1.5;spacing=14;align=left;fontSize=19;">
          <mxGeometry as="geometry" x="55" y="1012" width="355" height="122" />
        </mxCell>
        <mxCell id="chain6" value="&lt;b&gt;M4-A02 查询方案；M4-A03/A04 获取执行数据；M4-A05 上报次数&lt;/b&gt;&lt;br&gt;&lt;br&gt;N、K 均为次数；后端按上报记录去重累计。M4-A08 返回 K ≥ N 的完成结论及剩余次数。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf6ee;strokeColor=#72a17f;strokeWidth=1.5;spacing=14;align=left;fontSize=17;">
          <mxGeometry as="geometry" x="430" y="1012" width="1675" height="122" />
        </mxCell>
        <mxCell id="f7" value="&lt;b&gt;07 APP 直接控制微晶&lt;/b&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2ff;strokeColor=#688abb;strokeWidth=1.5;spacing=14;align=left;fontSize=19;">
          <mxGeometry as="geometry" x="55" y="1149" width="355" height="122" />
        </mxCell>
        <mxCell id="chain7" value="&lt;b&gt;M2-A04 能力 → M4-A03 核验登记 → 本地操作 → M4-A05 次数&lt;/b&gt;&lt;br&gt;&lt;br&gt;换人/断网参照云台，恢复复用 M4-A04；停止后 M4-A06 收尾。锁屏/关闭时处理暂不展开。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf6ee;strokeColor=#72a17f;strokeWidth=1.5;spacing=14;align=left;fontSize=17;">
          <mxGeometry as="geometry" x="430" y="1149" width="1675" height="122" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;一个 HTTP 申请可覆盖多个业务判断：&lt;/b&gt;M4-A03 统一完成核验、微晶就绪条件、占用检查和登记。&lt;br&gt;暂停/停止是端侧动作；M4-A06 接收已停止后的收尾确认，不发送停止指令。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#f5f7f9;strokeColor=#98a3af;strokeWidth=1.5;spacing=14;text;fillColor=none;strokeColor=none;align=left;fontSize=18;spacing=0;">
          <mxGeometry as="geometry" x="55" y="1320" width="2060" height="80" />
        </mxCell>
        <mxCell id="source" value="依据：原流程图 V4、用例图 V8、角色边界说明。完整 HTTP 方法、路径、调用方、输入/输出及流程节点映射见配套 Markdown。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#f5f7f9;strokeColor=#98a3af;strokeWidth=1.5;spacing=14;text;fillColor=none;strokeColor=none;align=left;fontSize=14;spacing=0;">
          <mxGeometry as="geometry" x="55" y="1440" width="2060" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
