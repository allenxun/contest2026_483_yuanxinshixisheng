          <mxGeometry x="50" y="1662" width="1900" height="56" as="geometry" />
        </mxCell>
        <mxCell id="upload" value="上传尚未同步的完成记录&lt;br&gt;&lt;font color=&quot;#245a9c&quot; style=&quot;font-size:14px&quot;&gt;M4-A05&lt;/font&gt;" vertex="1" parent="lane0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#233449;rounded=1;fillColor=#ffffff;strokeColor=#597493;strokeWidth=2;fontSize=22;align=center;spacing=8;fontSize=16;">
