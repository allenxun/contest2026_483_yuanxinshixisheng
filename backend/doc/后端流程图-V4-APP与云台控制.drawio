        <mxCell id="identifynote" value="可靠新成员与不确定匹配须区分；不能误建档或归错人。&lt;br&gt;绑定账号不是人脸查看授权；候选集合由受控测肤上下文及算法对接确定。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#233449;text;align=center;verticalAlign=middle;fontSize=21;">
          <mxGeometry x="75.0" y="2395.0" width="1850" height="90" as="geometry" />
        </mxCell>
        <mxCell id="querynote" value="OSS 图片与 PG 引用需要失败补偿，不能当成一个数据库事务；失败/重试不得重复受理或回退任务。&lt;br&gt;算法临时链接不作为永久图片引用；图片读取协议、重试次数与存储期限由开发确定。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#233449;text;align=center;verticalAlign=middle;fontSize=21;">
          <mxGeometry x="75.0" y="2585.0" width="1850" height="90" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="云台独立认证；绑定账号不授予成员资料权限。&lt;br&gt;云台只取本次任务结果，无历史列表；人脸候选范围由开发对接。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#233449;text;align=center;verticalAlign=middle;fontSize=21;">
          <mxGeometry x="75.0" y="2745.0" width="1850" height="90" as="geometry" />
        </mxCell>
        <mxCell id="current_task_request" value="重启/下次继续：云台认证后&lt;br&gt;M3-A06 获取当前任务" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;">
          <mxGeometry as="geometry" x="100" y="3020.0" width="550" height="150" />
        </mxCell>
        <mxCell id="current_task_restore" value="后端保存唯一当前任务及方案关联&lt;br&gt;只恢复本次；N/K 持久保存&lt;br&gt;新测肤受理即替换，无历史列表" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;">
          <mxGeometry as="geometry" x="800" y="3020.0" width="680" height="150" />
        </mxCell>
        <mxCell id="current_task_continue" value="M3-A03/A05 获取本次报告&lt;br&gt;M4-A03/A04 核验领取方案和进度&lt;br&gt;不自动启动；旧资料留给授权 APP" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;">
