# E 黑盒验收隔离环境样例（全部为占位符；真实凭据只放运行环境，不入 Git）。
# 约定详见 plans/isolation-and-doubles.md；framework/isolation.py 会做 fail-closed 校验。

# 被测 Java Web 入口（A 基线交付的 E 专用实例，经 Nginx 或直连）
E_ACCEPTANCE_BASE_URL=http://127.0.0.1:18091

# E 专用 PostgreSQL：库名必须以 eaccept_ 开头；端口按 worktree 隔离（样例 15432，
# 拒绝默认 5432）。主机/端口/库/用户使用 A 的镜像或 docker run 起的独立实例。
E_ACCEPTANCE_PG_HOST=127.0.0.1
E_ACCEPTANCE_PG_PORT=15432
E_ACCEPTANCE_PG_DATABASE=eaccept_mvp_e_<worktree-suffix>
E_ACCEPTANCE_PG_USER=eaccept_e
# 密码：不写本文件。运行时导出 PGPASSWORD 或 A 约定的环境变量名。

# run-id 前缀（每次运行自动追加 UTC 时间戳与随机段）
E_ACCEPTANCE_RUN_ID_PREFIX=E-mvpe

# 证据输出目录（默认 backend/acceptance/reports/evidence，reports/ 不入 Git）
E_ACCEPTANCE_EVIDENCE_DIR=

# 运行模式由 run.sh 注入：selfcheck | matrix（勿手改语义）
E_ACCEPTANCE_MODE=matrix
