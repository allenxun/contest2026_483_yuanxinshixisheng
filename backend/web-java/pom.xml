<?xml version="1.0" encoding="UTF-8"?>
<!--
  版本锁定（A 包 decisions.md）：
  - Spring Boot parent: 3.5.16（Maven Central 最新 3.5.x patch，2026-09-10 解析）
  - Flyway: 继承 Boot BOM 的 ${flyway.version}（flyway-core + flyway-database-postgresql）
  - PostgreSQL driver / HikariCP: 继承 Boot BOM
  - Java 21 (Temurin 21.0.12), Maven 3.8.7
  实际解析版本以 `mvn dependency:tree` 为准，亦记录于 backend/deploy/README.md VERSIONS 节。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>cn.yuanxin.mvp</groupId>
  <artifactId>web-java</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>web-java</name>
  <description>MVP Web 后端（Spring MVC + Spring JDBC + Flyway）</description>
  <properties>
    <java.version>21</java.version>
    <!-- springdoc-openapi 2.8.x 线（B 包 Swagger 接入）：2.8.17 为该线最新
         patch，面向 Spring Framework 6.2 / Spring Boot 3.4–3.5；仅由
         webmvc-ui starter 引入，运行时/编译期 API 均落在 io.swagger.v3.*。 -->
    <springdoc.version>2.8.17</springdoc.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- B 包 Swagger/OpenAPI：从实际 Controller/DTO 生成 /v3/api-docs + Swagger UI。
         仅 dev/test profile 启用（application.yml），生产默认关闭并由
         DocsProductionGuard fail-closed。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- 真实阿里云短信（V2.0 SDK，官方推荐线）：仅 app.sms.provider=aliyun 时装配。
         唯一 SDK 触点收敛在 cn.yuanxin.mvp.web.sms.AliyunSmsSendGateway。 -->
    <dependency>
      <groupId>com.aliyun</groupId>
      <artifactId>dysmsapi20170525</artifactId>
      <version>4.6.0</version>
    </dependency>
    <!-- 真实阿里云 OSS（V1 SDK，与 StoragePort 的 putObject/getObject/... 面匹配）：
         仅 app.storage.provider=aliyun 时装配。唯一 SDK 触点收敛在
         cn.yuanxin.mvp.web.storage.OssStorageAdapter。 -->
    <dependency>
      <groupId>com.aliyun.oss</groupId>
      <artifactId>aliyun-sdk-oss</artifactId>
      <version>3.18.5</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- 本模块集成测试以 *IT 命名（真实 PG 16）；与默认 *Test 一起跑 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
      <!-- deploy/dev/migrate.sh 使用: mvn -f backend/web-java/pom.xml -Dflyway.url=... org.flywaydb:flyway-maven-plugin:${flyway.version}:migrate
           版本与 Boot BOM 的 flyway-core 保持一致（${flyway.version} 由 parent 定义） -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <version>${flyway.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
