# VelaVision integrated diagnostic build; no auto-start.
CONFIG_EXAMPLES_GIMBAL=y
CONFIG_EXAMPLES_K7HOST=y
CONFIG_EXAMPLES_K7HOST_JPEG=y
CONFIG_EXAMPLES_K7HOST_YUNET=y
CONFIG_EXAMPLES_K7HOST_TRACK=y
CONFIG_RK3576_NPU_DIAG=y
CONFIG_EXAMPLES_K7NPU=y
CONFIG_K7NPU_MMU_TEST=y
CONFIG_K7NPU_RAW_TEST=y
CONFIG_NET_ETHERNET=y
CONFIG_NET_IPv4=y
CONFIG_NET_UDP=y
CONFIG_NET_TCP=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_ICMP=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NETUTILS_DHCPC=y
CONFIG_SYSTEM_PING=y
CONFIG_NET_LL_GUARDSIZE=32
CONFIG_IOB_NBUFFERS=128
CONFIG_NET_STATISTICS=y
CONFIG_EXAMPLES_K7RADIO_IP=y
# SDIO command transport and measured WLAN RTT exceed the default 20 ms.
# Keep retries bounded: five attempts, 250 ms response waits.
CONFIG_ARP_SEND_DELAYMSEC=250
CONFIG_ARP_SEND_MAXTRIES=5

CONFIG_RK3576_MODEL_ARENA=y
CONFIG_EXAMPLES_K7MEM=y
CONFIG_EXAMPLES_K7EMMC=y

CONFIG_BCH=y
CONFIG_BCH_DEVICE_READONLY=y

# Experimental integration: default services inherit CPU0; compute workers opt in.
CONFIG_RK3576_SMP_DIAG=y
CONFIG_SMP=y
CONFIG_SMP_DEFAULT_CPUSET=0x1
CONFIG_EXAMPLES_K7SMP=y

CONFIG_EXAMPLES_K7LOAD=y
