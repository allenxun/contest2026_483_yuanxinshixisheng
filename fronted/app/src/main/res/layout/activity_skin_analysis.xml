<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/skin_analysis_page_bg"
    android:orientation="vertical"
    android:paddingTop="60dp">

    <!-- 顶部导航栏 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_back"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="肌肤智能检测"
            android:textColor="#2D2D2D"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 卡片列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- 肤质检测卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_skin_detect"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_skin_detect_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="肤质检测"
                    android:textColor="#3D3D3D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <ImageView
                    android:id="@+id/img_skin_detect"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="肤质检测"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3D人脸模型生成卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_face_model"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_face_model_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3D人脸模型生成"
                    android:textColor="#3D3D3D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <ImageView
                    android:id="@+id/img_face_model"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="3D人脸模型生成"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 人脸检测卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_beauty_detect"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_beauty_detect_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="人脸检测"
                    android:textColor="#3D3D3D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <ImageView
                    android:id="@+id/img_beauty_detect"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="人脸检测"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>