<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingTop="0dp">

    <!-- 左上角返回按钮 -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="返回" />

    <!-- 占位：让标题区域距顶部约30% -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="25" />

    <!-- 内容区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="75"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- 描述 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_desc"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- 短信登录 / 密码登录切换 -->
        <LinearLayout
            android:id="@+id/layoutLoginMethodSwitch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_login_method_switch"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tvSmsLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_login_method_selected"
                android:gravity="center"
                android:text="@string/sms_login"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPasswordLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/password_login"
                android:textColor="#666666"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 手机号行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_label"
                android:textColor="#333333"
                android:textSize="15sp"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/phone_hint"
                android:inputType="phone"
                android:maxLength="11"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#333333"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 验证码行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/tvCredentialLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/code_label"
                android:textColor="#333333"
                android:textSize="15sp"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/etCode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/code_hint"
                android:inputType="number"
                android:maxLength="6"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#333333"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnGetCode"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="#af8d59"
                android:text="@string/get_code"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- 登录按钮 -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#af8d59"
            android:text="@string/login"
            android:textColor="#ffffff"
            android:textSize="15sp" />

        <!-- 注册按钮（默认隐藏） -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#af8d59"
            android:text="注册"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- 隐私协议 + 去注册/返回登录 同一行 -->
        <RelativeLayout
            android:id="@+id/layoutPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <!-- 自定义复选框 -->
            <FrameLayout
                android:id="@+id/flCheckbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <!-- 未选中：灰色边框方框 -->
                <View
                    android:id="@+id/vCheckboxBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cb_unchecked_bg" />

                <!-- 选中：白色打勾（默认隐藏） -->
                <ImageView
                    android:id="@+id/ivCheckmark"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_white"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 隐私协议文字 -->
            <TextView
                android:id="@+id/tvPrivacyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/flCheckbox"
                android:layout_centerVertical="true"
                android:textSize="12sp"
                android:textColor="#666666"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <!-- 去注册，靠右（登录模式显示） -->
            <TextView
                android:id="@+id/tvGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="去注册"
                android:textColor="#af8d59"
                android:textSize="14sp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground" />

            <!-- 返回登录，靠右（注册模式才显示） -->
            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="返回登录"
                android:textColor="#af8d59"
                android:textSize="14sp"
                android:padding="4dp"
                android:visibility="gone"
                android:background="?attr/selectableItemBackground" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
