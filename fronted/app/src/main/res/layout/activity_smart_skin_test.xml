<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 第1层：相机预览 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 第2层：蓝色科技遮罩 -->
    <View
        android:id="@+id/view_blue_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scan_overlay_bg"
        android:clickable="false"
        android:focusable="false" />

    <!-- 第3层：外框装饰层 -->
    <FrameLayout
        android:id="@+id/layout_frame_decoration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <!-- 顶部暗色渐变条 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/top_gradient_bar" />

        <!-- 底部暗色渐变条 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_gradient_bar" />

        <!-- 顶部中央小亮点 -->
        <View
            android:layout_width="40dp"
            android:layout_height="6dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="50dp"
            android:background="@drawable/top_indicator_dot" />
    </FrameLayout>

    <!-- 第4层：扫描框区域 -->
    <FrameLayout
        android:id="@+id/layout_scan_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="230dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">

        <!-- 人脸轮廓（二次贝塞尔曲线 + 霓虹发光效果） -->
        <com.example.aisia.ui.skintest.FaceGuideView
            android:id="@+id/iv_face_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="120dp" />

        <!-- 扫描线 -->
        <View
            android:id="@+id/view_scan_line"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/scan_line_gradient" />

        <!-- 四角装饰 -->
        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:background="@drawable/corner_top_left" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:background="@drawable/corner_top_right" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/corner_bottom_left" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/corner_bottom_right" />

        <!-- 左侧刻度线 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" />
        </LinearLayout>

        <!-- 右侧刻度线 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" android:layout_marginBottom="20dp" />
            <View android:layout_width="12dp" android:layout_height="1dp" android:background="#404A9EFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- 第4.5层：人脸对齐提示文字 -->
    <TextView
        android:id="@+id/tv_face_align_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="250dp"
        android:text="请正对镜头，将整张脸放入圆形提示框"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:visibility="visible" />

    <!-- 第5层：扫描框底部装饰 -->
    <LinearLayout
        android:id="@+id/layout_scan_bottom_decoration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="180dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="false"
        android:focusable="false">

        <View
            android:layout_width="60dp"
            android:layout_height="1dp"
            android:background="@drawable/line_gradient_left" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_glow" />

        <View
            android:layout_width="60dp"
            android:layout_height="1dp"
            android:background="@drawable/line_gradient_right" />
    </LinearLayout>

    <!-- 第6层：自定义导航栏 -->
    <LinearLayout
        android:id="@+id/layout_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- 左侧返回按钮 -->
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="返回"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF" />

        <!-- 中央装饰 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:background="@drawable/line_gradient_left" />

            <View
                android:layout_width="24dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/nav_capsule_indicator" />

            <View
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:background="@drawable/line_gradient_right" />
        </LinearLayout>

        <!-- 右侧三点菜单 -->
        <LinearLayout
            android:id="@+id/layout_menu"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/menu_capsule_bg">

            <View android:layout_width="4dp" android:layout_height="4dp" android:background="#FFFFFF" android:layout_marginEnd="3dp" />
            <View android:layout_width="4dp" android:layout_height="4dp" android:background="#FFFFFF" android:layout_marginEnd="3dp" />
            <View android:layout_width="4dp" android:layout_height="4dp" android:background="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第7层：底部控制区 -->
    <LinearLayout
        android:id="@+id/layout_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="40dp">

        <!-- 左侧相册按钮 -->
        <FrameLayout
            android:id="@+id/btn_gallery"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_gallery_bg">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/gallery_inner_circle" />
        </FrameLayout>

        <!-- 装饰线 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/line_gradient_left" />

        <!-- 中央拍照按钮 -->
        <FrameLayout
            android:id="@+id/btn_capture"
            android:layout_width="100dp"
            android:layout_height="100dp">

            <!-- 第1层：外圈圆弧轨道1 -->
            <View
                android:id="@+id/view_arc1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/capture_arc1" />

            <!-- 第1层：外圈圆弧轨道2 -->
            <View
                android:id="@+id/view_arc2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/capture_arc2" />

            <!-- 第1层：外圈圆弧轨道3 -->
            <View
                android:id="@+id/view_arc3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/capture_arc3" />

            <!-- 第2层：脉冲呼吸圆 -->
            <View
                android:id="@+id/view_pulse_circle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/capture_pulse_circle" />

            <!-- 第3层：蓝色内填充圆 -->
            <View
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/capture_inner_fill" />

            <!-- 第4层：内阴影框 -->
            <View
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:background="@drawable/capture_inner_shadow" />

            <!-- 第5层：白色核心圆 + 文字 -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/capture_core_circle">

                <TextView
                    android:id="@+id/tv_capture_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="测肤"
                    android:textColor="#0A1929"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </FrameLayout>
        </FrameLayout>

        <!-- 装饰线 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/line_gradient_right" />

        <!-- 右侧设置按钮 -->
        <FrameLayout
            android:id="@+id/btn_settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_settings_bg">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/settings_inner_circle" />
        </FrameLayout>
    </LinearLayout>

    <!-- 第8层：图片预览层 -->
    <FrameLayout
        android:id="@+id/layout_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 底部渐变层 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="bottom"
            android:background="@drawable/preview_bottom_gradient" />

        <!-- 底部按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/btn_retake"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="重新拍照"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/btn_retake_bg"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="确定"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/btn_confirm_bg" />
        </LinearLayout>
    </FrameLayout>

    <!-- 第9层：智能分析蒙层 -->
    <FrameLayout
        android:id="@+id/layout_analyzing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- 蒙层背景 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/analyzing_bg" />

        <!-- 背景光斑1 -->
        <View
            android:id="@+id/view_glow1"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:layout_marginStart="-100dp"
            android:layout_marginTop="-100dp"
            android:background="@drawable/glow_spot"
            android:alpha="0.3" />

        <!-- 背景光斑2 -->
        <View
            android:id="@+id/view_glow2"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:layout_marginEnd="-80dp"
            android:layout_marginBottom="-80dp"
            android:background="@drawable/glow_spot"
            android:alpha="0.2" />

        <!-- 左上角关闭按钮 -->
        <ImageView
            android:id="@+id/iv_close_analyzing"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="44dp"
            android:layout_marginStart="16dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF" />

        <!-- 中央扫描动画区域 -->
        <FrameLayout
            android:id="@+id/layout_scan_animation"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="100dp">

            <!-- 最外圈柔和光环 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/scan_outer_glow" />

            <!-- 旋转光圈1 -->
            <View
                android:id="@+id/view_ring1"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/scan_ring1" />

            <!-- 旋转光圈2 -->
            <View
                android:id="@+id/view_ring2"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/scan_ring2" />

            <!-- 旋转光圈3 -->
            <View
                android:id="@+id/view_ring3"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/scan_ring3" />

            <!-- 人脸占位椭圆 -->
            <View
                android:layout_width="100dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:background="@drawable/face_placeholder" />

            <!-- 纵向扫描线 -->
            <View
                android:id="@+id/view_analyzing_scan_line"
                android:layout_width="100dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="35dp"
                android:background="@drawable/scan_line_gradient" />

            <!-- 浮动粒子 -->
            <View android:id="@+id/particle1" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/particle_dot" android:layout_gravity="top|start" android:layout_marginTop="20dp" android:layout_marginStart="20dp" />
            <View android:id="@+id/particle2" android:layout_width="4dp" android:layout_height="4dp" android:background="@drawable/particle_dot" android:layout_gravity="top|end" android:layout_marginTop="30dp" android:layout_marginEnd="25dp" />
            <View android:id="@+id/particle3" android:layout_width="5dp" android:layout_height="5dp" android:background="@drawable/particle_dot" android:layout_gravity="bottom|start" android:layout_marginBottom="25dp" android:layout_marginStart="30dp" />
            <View android:id="@+id/particle4" android:layout_width="4dp" android:layout_height="4dp" android:background="@drawable/particle_dot" android:layout_gravity="bottom|end" android:layout_marginBottom="20dp" android:layout_marginEnd="20dp" />
            <View android:id="@+id/particle5" android:layout_width="5dp" android:layout_height="5dp" android:background="@drawable/particle_dot" android:layout_gravity="center|start" android:layout_marginStart="10dp" />
            <View android:id="@+id/particle6" android:layout_width="4dp" android:layout_height="4dp" android:background="@drawable/particle_dot" android:layout_gravity="center|end" android:layout_marginEnd="10dp" />
        </FrameLayout>

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_analyzing_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="320dp"
            android:text="正在深度分析你的肌肤"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- 副标题 -->
        <TextView
            android:id="@+id/tv_analyzing_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="352dp"
            android:text="请勿退出页面"
            android:textColor="#804A9EFF"
            android:textSize="14sp" />

        <!-- 进度条区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="390dp"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <!-- 进度文字 -->
            <TextView
                android:id="@+id/tv_upload_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上传 0%"
                android:textColor="#4A9EFF"
                android:textSize="14sp" />

            <!-- 进度条 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/progress_bar_bg" />

                <View
                    android:id="@+id/view_progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/progress_bar_fill" />

                <!-- 进度条末端光球 -->
                <View
                    android:id="@+id/view_progress_glow"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/progress_glow_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 8条分析维度列表 -->
        <LinearLayout
            android:id="@+id/layout_analysis_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="440dp"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <!-- 分析项1 -->
            <LinearLayout
                android:id="@+id/item_analysis_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/item_icon_1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/analysis_item_inactive" />

                <TextView
                    android:id="@+id/item_text_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="面部图像清晰度校准"
                    android:textColor="#60FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/item_status_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 分析项2 -->
            <LinearLayout
                android:id="@+id/item_analysis_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/item_icon_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/analysis_item_inactive" />

                <TextView
                    android:id="@+id/item_text_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="面部区域分割"
                    android:textColor="#60FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/item_status_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#80FFFFFF"
