<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 头像 -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_consult_avatar" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="头像"
            android:src="@drawable/ic_person_outline" />
    </FrameLayout>

    <!-- 名称和预览 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvConsultName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="张美容师"
            android:textColor="#2D2D2D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConsultPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="您好，您的皮肤检测报告已生成，请查看。"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 时间 -->
    <TextView
        android:id="@+id/tvConsultTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="10:32"
        android:textColor="#B0B0B5"
        android:textSize="11sp" />

</LinearLayout>