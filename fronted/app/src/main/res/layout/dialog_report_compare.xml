<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_compare_bg"
    android:orientation="vertical">

    <!-- 提示文案：左对齐，与下方列表项 paddingStart 对齐 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:text="请选择需要对比的两条测肤记录"
        android:textColor="#666666"
        android:textSize="14sp" />

    <!-- 报告列表：用 weight 自适应，保证底部按钮始终可见可点击 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCompareList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- 底部分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#F0F0F0" />

    <!-- 底部按钮区域：仅保留确认按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/btnDialogConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_compare_primary_bg"
            android:text="对比"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>