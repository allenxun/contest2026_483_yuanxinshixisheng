            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.devicehistory.HistoryPlanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.devicehistory.PlanDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mine.ProfileActivity"
