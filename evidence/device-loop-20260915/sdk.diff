+      printf("K7CLOUD device round=%u\n",round+1);
+      rc=device_round(ip,epoch);
+      if(rc)break;
+      usleep(250000);
+    }
+  k7cloud_device_stop();
+  atomic_store(&device_loop_busy,false);
+  printf("K7CLOUD device loop_done=%d\n",rc);return rc;
+}
