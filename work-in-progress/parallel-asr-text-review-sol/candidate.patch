diff --git a/app/voicelink/src/native_asr_runtime.cpp b/app/voicelink/src/native_asr_runtime.cpp
--- a/app/voicelink/src/native_asr_runtime.cpp
+++ b/app/voicelink/src/native_asr_runtime.cpp
@@
 namespace {
+constexpr unsigned kMaxMicrophoneFrames = 48000;
@@
-  const size_t length = std::strlen(source);
-  if (length >= capacity) return -ENOSPC;
+  size_t length = 0;
+  while (length < capacity && source[length]) ++length;
+  if (length == capacity) return -ENOSPC;
@@
-  if (pthread_mutex_trylock(&asr_gate)) {
