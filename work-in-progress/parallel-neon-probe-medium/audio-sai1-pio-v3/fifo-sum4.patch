+    ((v&SAI_FIFOLR_XFL1_MASK)>>SAI_FIFOLR_XFL1_SHIFT)+
+    ((v&SAI_FIFOLR_XFL2_MASK)>>SAI_FIFOLR_XFL2_SHIFT)+
+    ((v&SAI_FIFOLR_XFL3_MASK)>>SAI_FIFOLR_XFL3_SHIFT);
+}
