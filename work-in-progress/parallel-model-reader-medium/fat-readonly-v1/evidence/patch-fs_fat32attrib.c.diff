+
   FAR struct fat_mountpt_s *fs;
   struct fat_dirinfo_s dirinfo;
   struct inode_search_s desc;
@@ -188,5 +192,12 @@
 int fat_setattrib(FAR const char *path, fat_attrib_t setbits,
                   fat_attrib_t clearbits)
 {
+#ifdef CONFIG_FAT_FORCE_READONLY
