--- a/cmake/external/onnxruntime_external_deps.cmake
+++ b/cmake/external/onnxruntime_external_deps.cmake
@@ -85,7 +85,7 @@
 
 # Flatbuffers
 # We do not need to build flatc for iOS or Android Cross Compile
-if (CMAKE_SYSTEM_NAME STREQUAL "iOS" OR CMAKE_SYSTEM_NAME STREQUAL "Android" OR CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
+if (CMAKE_SYSTEM_NAME STREQUAL "iOS" OR CMAKE_SYSTEM_NAME STREQUAL "Android" OR CMAKE_SYSTEM_NAME STREQUAL "Emscripten" OR CMAKE_SYSTEM_NAME STREQUAL "NuttX")
   set(FLATBUFFERS_BUILD_FLATC OFF CACHE BOOL "FLATBUFFERS_BUILD_FLATC" FORCE)
 endif()
 set(FLATBUFFERS_BUILD_TESTS OFF CACHE BOOL "FLATBUFFERS_BUILD_TESTS" FORCE)
@@ -273,6 +273,13 @@
   set(CPUINFO_SUPPORTED FALSE)
 endif()
 
+if(CMAKE_SYSTEM_NAME STREQUAL "NuttX")
+  set(CPUINFO_SUPPORTED FALSE)
+  if(onnxruntime_USE_XNNPACK)
+    message(FATAL_ERROR "NuttX CPU gate does not support XNNPACK/cpuinfo")
+  endif()
+endif()
+
 # xnnpack depends on clog
 # Android build should use the system's log library instead of clog
 if ((CPUINFO_SUPPORTED OR onnxruntime_USE_XNNPACK) AND NOT ANDROID)
