+  s->pending=false;
+  if(s->view.state==VS_PENDING){
+   if(b->radio==WB_OWNED)s->view.state=VS_UNSUPPORTED;
+   else if(b->radio!=WB_FREE || b->clock_fault)s->view.state=VS_BUSY;
+   else if(sc_begin(&s->collector,id)!=SC_OK)s->view.state=VS_FAILED;
