+    b->active.status=WB_IP_READY; memcpy(b->active.ip,d->ip,4); b->radio=WB_OWNED; return;
+  }
+  terminate(b,WB_FAILED);
+  if(d->worker_exited && !d->link_up) free_radio(b);
+}
