+ if(e->ticket!=s->view.ticket||!s->view.held||e->sequence<=s->sequence){unlock(s);return WD_UNKNOWN;}
+ if(s->event_pending){unlock(s);return WD_FULL;}
+ s->event=*e;s->event_pending=true;unlock(s);return WD_OK;
