set(SHERPA_ONNX_ENABLE_JNI OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_TESTS OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_PORTAUDIO OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_WEBSOCKET OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_GPU OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_DIRECTML OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_RKNN OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_SPEAKER_DIARIZATION OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_SANITIZER OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_TTS OFF CACHE BOOL "ASR first; use separate ON build for VITS")
