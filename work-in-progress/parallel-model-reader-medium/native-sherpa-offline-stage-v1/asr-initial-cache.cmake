if(NOT IS_DIRECTORY "${K7_SHERPA_DEPS_ROOT}")
  message(FATAL_ERROR "Set K7_SHERPA_DEPS_ROOT to extracted sources before loading cache")
endif()
# Initial-cache candidate for a NEW real NuttX toolchain build.
set(BUILD_SHARED_LIBS OFF CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_C_API ON CACHE BOOL "")
set(SHERPA_ONNX_ENABLE_BINARY OFF CACHE BOOL "")
set(SHERPA_ONNX_BUILD_C_API_EXAMPLES OFF CACHE BOOL "")
