# Derived from velavision_spoken_tts_local.  This is a compile/link candidate.
# It deliberately keeps HTTPS runtime trust gates closed until the RK3576
# entropy source and trusted wall-time source have independent board evidence.

# Preserve the accepted speech/profile contract.
CONFIG_RK3576_MODEL_ARENA=y
CONFIG_EXAMPLES_K7RADIO_IP=y
CONFIG_EXAMPLES_K7RADIO_SHARED=y
CONFIG_EXAMPLES_K7SOUND=y
CONFIG_EXAMPLES_K7VOICE=y
CONFIG_FS_ROMFS=y
CONFIG_EXAMPLES_K7VOICE_STAGED_ASSETS=y
CONFIG_NET=y
CONFIG_NET_IPv4=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_SOCKOPTS=y

# Add the already independently compiled DNS/HTTPS link profile.
CONFIG_LIBC_NETDB=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NETDB_DNSCLIENT_ENTRIES=2
CONFIG_NETDB_DNSCLIENT_NAMESIZE=128
CONFIG_NETDB_DNSCLIENT_MAXRESPONSE=512
CONFIG_NETDB_DNSCLIENT_SEND_TIMEOUT=1
CONFIG_NETDB_DNSCLIENT_RECV_TIMEOUT=1
CONFIG_NETDB_DNSCLIENT_RETRIES=1
CONFIG_NETDB_DNSSERVER_NAMESERVERS=1
CONFIG_NETDB_DNSSERVER_NOADDR=y
CONFIG_CRYPTO_MBEDTLS=y
# CONFIG_MBEDTLS_SSL_SRV_C is not set
# CONFIG_MBEDTLS_SSL_PROTO_DTLS is not set
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384
CONFIG_EXAMPLES_K7CLOUD=y

# Honest link-only boundary.  Do not remove these lines merely to make TLS run.
# CONFIG_CLOCK_TIMEKEEPING is not set
# CONFIG_DEV_URANDOM is not set
# CONFIG_RTC is not set
