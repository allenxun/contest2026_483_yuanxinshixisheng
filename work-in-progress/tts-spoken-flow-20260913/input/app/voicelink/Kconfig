config EXAMPLES_K7VOICE
	bool "K7 native VoiceLink integration"
	depends on EXAMPLES_K7RADIO_SHARED && HAVE_CXX && LIBCXX && CXX_EXCEPTION
	default n
	---help---
		Native network adapter and control core. ASR/TTS not integrated yet.
		Explicit probe/scan commands are integration diagnostics, not speech.

config EXAMPLES_K7VOICE_STAGED_ASSETS
	bool "Reserve upper model window for staged speech assets"
	depends on EXAMPLES_K7VOICE && RK3576_MODEL_ARENA
	default n
	---help---
		Use only the lower 512 MiB for the model heap. Keep the upper
		512 MiB mapped for explicitly verified ASR and TTS RAM resources.
