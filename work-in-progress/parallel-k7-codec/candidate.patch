+ c.next_id=UINT64_MAX;start(&c,&p);CHECK(kc_cancel(&c,c.id)==KC_OK);CHECK(kc_poll(&c)==KC_CANCELLED);
+ CHECK(kc_cleanup(&c,c.id,200)==KC_OK);CHECK(kc_start(&c,&p,100,&id)==KC_EXHAUSTED);
