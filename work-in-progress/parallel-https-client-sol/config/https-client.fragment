# Candidate only. Merge into a new, independent RK3576 defconfig and run
# olddefconfig; do not overwrite an accepted image configuration.
CONFIG_NET_TCP=y
CONFIG_NET_SOCKOPTS=y
CONFIG_CRYPTO_MBEDTLS=y
CONFIG_MBEDTLS_SSL_SRV_C=n
CONFIG_MBEDTLS_SSL_PROTO_DTLS=n
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384
CONFIG_VELAVISION_HTTPS_CLIENT_CANDIDATE=y
CONFIG_VELAVISION_HTTPS_REQUEST_HEADER_MAX=4096
CONFIG_VELAVISION_HTTPS_RESPONSE_HEADER_MAX=8192
CONFIG_VELAVISION_HTTPS_RESPONSE_BODY_MAX=262144
CONFIG_VELAVISION_HTTPS_CHUNK_MAX=32768
